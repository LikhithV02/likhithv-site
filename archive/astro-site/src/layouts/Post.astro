---
import Base from './Base.astro';
const { frontmatter } = Astro.props;
---
<Base title={`${frontmatter.title} — Likhith V`} description={frontmatter.description}>
  <article class="post page-width"><a class="back-link" href="/writing/">← All writing</a><header><p class="section-index">{new Date(frontmatter.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</p><h1>{frontmatter.title}</h1><p>{frontmatter.description}</p></header><div class="prose"><slot /></div></article>
</Base>
