---
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/content';
export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
const next = projects[(projects.findIndex((item) => item.slug === project.slug) + 1) % projects.length];
---
<Base title={`${project.name} — Likhith V`} description={project.summary}>
  <article class="project-detail page-width">
    <a class="detail-back" href="/#projects">← All projects</a>
    <header class="detail-header"><div><p class="section-index">{project.category}</p><h1>{project.name}</h1></div><p>{project.summary}</p></header>
    <div class="detail-grid"><h2>The problem</h2><p>{project.problem}</p></div>
    <div class="detail-grid"><h2>What I built</h2><ul>{project.contribution.map((item: string) => <li>{item}</li>)}</ul></div>
    <div class="detail-grid"><h2>How it works</h2><div class="architecture-flow">{project.architecture.map((step: string, index: number) => <><span>{step}</span>{index < project.architecture.length - 1 && <i aria-hidden="true">→</i>}</>)}</div></div>
    <div class="detail-grid"><h2>Tools</h2><div class="tag-row">{project.tags.map((tag: string) => <span>{tag}</span>)}</div></div>
    <div class="detail-links">{project.links.map((link: {label: string; href: string}) => <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}</div>
    <a class="detail-next" href={`/projects/${next.slug}/`}>Next project: {next.name} <span aria-hidden="true">↗</span></a>
  </article>
</Base>
